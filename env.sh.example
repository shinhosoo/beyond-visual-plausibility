#!/usr/bin/env bash
# Usage:  source env.sh      (must be sourced, not executed)
# Keep this file in the repository root, next to SkinCancer/.

# --- package import path -----------------------------------------------------
export PYTHONPATH="$PWD:${PYTHONPATH:-}"

# --- data locations ----------------------------------------------------------
# the parent directory that contains HAM10000_images_part_1 and part_2
export HAM_DATA_ROOT=/path/to/HAM10000_extracted

# lesion-level splits used for every number in the paper
export HAM_SPLIT_ROOT="$PWD/splits_paper_seed42"

# lesion segmentation masks (used during training and for the overlap metrics)
export HAM_MASK_DIR="$PWD/masks_ham10000"

# where checkpoints, predictions and confidence intervals are written
export HAM_OUTPUT_ROOT="$PWD/outputs"

export HAM_GPU=0

# --- hyper-parameters --------------------------------------------------------
# The code defaults already match the paper, so these two lines are optional.
#   HAM_WEIGHT_DECAY  default 5e-5
#   HAM_AUGMENT       default paper  (vflip 0.2, rotation 30, jitter 0.1)
#                     set to "code"  to reproduce the original defaults
#                                    (vflip 0.5, rotation 180, jitter 0.2)
export HAM_WEIGHT_DECAY=5e-5
export HAM_AUGMENT=paper

#   HAM_HEAD_ACT      default relu   activation of the classification head
#   HAM_N_SLOTS       default 4      number of LTV slots
# export HAM_HEAD_ACT=relu
# export HAM_N_SLOTS=4

# per-batch tensor logging (off by default)
# export SKINCANCER_DEBUG=1

mkdir -p "$HAM_OUTPUT_ROOT" logs

echo "PYTHONPATH        = $PWD"
echo "HAM_DATA_ROOT     = $HAM_DATA_ROOT"
echo "HAM_SPLIT_ROOT    = $HAM_SPLIT_ROOT"
echo "HAM_MASK_DIR      = $HAM_MASK_DIR"
echo "HAM_OUTPUT_ROOT   = $HAM_OUTPUT_ROOT"
echo "HAM_WEIGHT_DECAY  = ${HAM_WEIGHT_DECAY:-5e-5 (default)}"
echo "HAM_AUGMENT       = ${HAM_AUGMENT:-paper (default)}"

for p in "$HAM_DATA_ROOT" "$HAM_SPLIT_ROOT"; do
  [ -d "$p" ] || echo "  [warning] path not found: $p"
done
